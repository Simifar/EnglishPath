{
  "name": "cortexmap",
  "version": "1.0.0",
  "private": true,
  "description": "Русскоязычный статический справочник для самостоятельного изучения английского языка",
  "license": "MIT",
  "homepage": "https://simifar.github.io/EnglishPath/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Simifar/EnglishPath.git"
  },
  "bugs": {
    "url": "https://github.com/Simifar/EnglishPath/issues"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build && cp -R .next/static .next/standalone/.next/ && cp -R public .next/standalone/",
    "start": "NODE_ENV=production bun .next/standalone/server.js",
    "lint": "eslint src",
    "validate:data": "bun src/data/index.ts",
    "validate-content": "bun scripts/validate-content.ts",
    "check-external-links": "bun scripts/check-external-links.ts",
    "analyze": "ANALYZE=true bun run build",
    "check-bundle": "bun scripts/analyze-bundle.ts",
    "test": "bun test",
    "build:pages": "bun scripts/build-pages.ts",
    "preview:pages": "bun scripts/preview-pages.ts",
    "check:pages": "bun scripts/check-pages.ts"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
